# ==============================================================================
# OKINT-PRO C4ISR PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# SECURITY CLASSIFICATION: security_level: public (Synthetic Template)
#
# IMPORTANT OPSEC NOTICE:
# - NEVER commit real production credentials, API keys, or session tokens to Git.
# - This template contains ONLY synthetic placeholders (example.com, REDACTED).
# - Generate strong cryptographic keys using the commands provided below.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & LOGGING
# ------------------------------------------------------------------------------
ENVIRONMENT=development                # development | staging | production
SECURITY_TIER=public                  # public | research | restricted
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR
TIMEZONE=UTC

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL 15+ with PostGIS)
# ------------------------------------------------------------------------------
# For local Docker Compose deployment:
POSTGRES_DB=iskun_db
POSTGRES_USER=iskun_app_user
POSTGRES_PASSWORD=SYNTHETIC_PASSWORD_CHANGE_ME_IN_PROD
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Application SQLAlchemy connection string:
DATABASE_URL=postgresql+psycopg2://iskun_app_user:SYNTHETIC_PASSWORD_CHANGE_ME_IN_PROD@db:5432/iskun_db

# ------------------------------------------------------------------------------
# 3. MESSAGE BROKERS & CACHING (Redis & NATS)
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL_SECONDS=300
NATS_SERVER_URL=nats://nats:4222       # Optional JetStream event bus

# ------------------------------------------------------------------------------
# 4. PLATFORM SECURITY, RBAC & CRYPTOGRAPHY
# ------------------------------------------------------------------------------
# Master Fernet Salt for encrypting user tokens and sensitive data in DB.
# Generate a new 32-byte key before running:
#   openssl rand -hex 32
SECRET_KEY=SYNTHETIC_FERNET_SECRET_KEY_CHANGE_ME_WITH_OPENSSL_32_BYTES

# JWT Authentication for REST API
JWT_SECRET_KEY=SYNTHETIC_JWT_SECRET_KEY_REDACTED
JWT_ALGORITHM=HS256                    # In restricted ops: use RS256/Ed25519
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480    # Standard 8-hour shift token

# Policy-driven approval defaults
DEFAULT_APPROVAL_TTL_HOURS=8          # Duration of an authorized restricted session
AUTO_EXPIRE_APPROVALS=true

# Anti-BDA Coordinate Sanitization for Public endpoints:
# When true, public API rounds coordinates to ~2 km (approx 2 decimal places)
SANITIZE_PUBLIC_COORDINATES=true
PUBLIC_COORDINATE_PRECISION_DECIMALS=2

# ------------------------------------------------------------------------------
# 5. OSINT INGESTION & TELEGRAM (Telethon MTProto)
# ------------------------------------------------------------------------------
# Obtain from https://my.telegram.org (Keep strictly confidential in prod)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=synthetic_api_hash_0123456789abcdef01234567
TELEGRAM_SESSION_STRING=synthetic_telethon_session_string_placeholder
TELEGRAM_BOT_TOKEN=1234567890:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Ingestion target channels (Public OSINT monitors only)
TARGET_CHANNELS=@kpszsu,@vanek_office,@war_monitor,@eRadarrua,@monitor_ukr,@delta_odesa

# ------------------------------------------------------------------------------
# 6. EXTERNAL APIS & LLM ENGINES
# ------------------------------------------------------------------------------
# Primary High-Precision Threat Extractor (xAI Grok API)
XAI_API_KEY=xai-SYNTHETIC_XAI_KEY_REDACTED_PLACEHOLDER
XAI_MODEL=grok-4.20-0309-non-reasoning
MAX_XAI_DAILY_CALLS=600                # Budget control circuit breaker (~$0.10/day)

# Fallback Open-Weights LLM (Groq LPU Engine)
GROQ_API_KEY=gsk_SYNTHETIC_GROQ_KEY_REDACTED_PLACEHOLDER
GROQ_PRIMARY_MODEL=qwen/qwen-2.5-32b
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile

# Official Alerts & Meteorological Providers
ALERTS_API_TOKEN=synthetic_alerts_in_ua_token_placeholder
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
NASA_FIRMS_MAP_KEY=synthetic_nasa_firms_key_placeholder

# ------------------------------------------------------------------------------
# 7. SENSOR & TELEMETRY NETWORK LIMITS (Research & Simulation)
# ------------------------------------------------------------------------------
ENABLE_ACOUSTIC_SIMULATION=false
ENABLE_SDR_SIGMF_BUS=false
MAX_TELEMETRY_BATCH_SIZE=100
WORM_AUDIT_LOG_ENABLED=true
