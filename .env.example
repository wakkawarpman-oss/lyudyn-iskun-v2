# Telegram
BOT_TOKEN=your_bot_token
API_ID=your_api_id
API_HASH=your_api_hash
SESSION_STRING=your_telethon_session_string
TARGET_CHANNELS=@kyiv_ua,@oblast_kyiv

# Database (Supabase PostgreSQL with PostGIS)
DATABASE_URL=postgresql+psycopg2://postgres:password@db.supabase.co:5432/postgres
# Only used by docker-compose's local `db` service (postgis container) — must match DATABASE_URL above
POSTGRES_DB=iskun
POSTGRES_USER=iskun
POSTGRES_PASSWORD=change_me

# Redis
REDIS_URL=redis://redis:6379/0

# Required — Fernet salt for encrypting user API keys. Generate with:
#   openssl rand -hex 32
# Changing this on an existing deployment breaks decryption of previously
# stored keys unless the legacy salt fallback in database/models.py is kept.
SECRET_KEY=

# AI APIs
GROQ_API_KEY=your_groq_key
OPENAI_API_KEY=your_openai_key_for_vision
